# /etc/congregation-sync/congregation-sync.env
# Owner root, mode 600:  sudo install -m 600 -o root -g root congregation-sync.env.example /etc/congregation-sync/congregation-sync.env

# Listen on loopback only; the reverse proxy terminates TLS.
Urls=http://127.0.0.1:5080

# Needed only while creating the vault. Generate one with:
#   openssl rand -base64 33
# Leave it empty afterwards: that disables vault creation completely
# (existing devices keep working, and invites still add new devices).
SyncServer__Registration__Secret=

# SQLite (simplest; one file to back up):
SyncServer__Database__Provider=Sqlite
SyncServer__Database__ConnectionString=Data Source=/var/lib/congregation-sync/sync.db

# Or PostgreSQL (tables are prefixed cm_, so a shared database is fine):
# SyncServer__Database__Provider=Postgres
# SyncServer__Database__ConnectionString=Host=/var/run/postgresql;Database=congregation_sync;Username=congregation_sync

# Plain-HTTP requests are refused unless a trusted proxy forwarded HTTPS.
# Loopback proxies are trusted automatically; list any other proxy here.
SyncServer__Security__RequireHttps=true
# SyncServer__Security__TrustedProxies__0=10.0.0.5

# Optional tuning (defaults shown):
# SyncServer__RateLimits__AnonymousPerMinute=10
# SyncServer__RateLimits__DevicePerMinute=600
# SyncServer__Limits__MaxDevicesPerVault=25
