{
  "Urls": "http://127.0.0.1:5080",
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "SyncServer": {
    "Database": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=congregation-sync.db"
    },
    "Registration": {
      "Secret": ""
    },
    "Security": {
      "RequireHttps": true,
      "TrustedProxies": []
    },
    "Limits": {
      "MaxRecordBytes": 262144,
      "MaxOperationsPerPush": 500,
      "MaxPullPageSize": 1000,
      "MaxDevicesPerVault": 25,
      "MaxActiveInvitesPerVault": 10,
      "MaxRequestBodyBytes": 16777216
    },
    "RateLimits": {
      "AnonymousPerMinute": 10,
      "DevicePerMinute": 600
    }
  }
}
